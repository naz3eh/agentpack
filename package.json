{
  "name": "agentpack",
  "private": true,
  "version": "0.1.0",
  "description": "Distribution + install layer for AI agents: manifest, registry, CLI, scoped runtime.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node --test packages/*/dist/*.test.js",
    "lint": "eslint .",
    "clean": "tsc -b --clean && rm -rf packages/*/dist examples/*/dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
